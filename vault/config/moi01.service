# ──────────────────────────────────────────────────────────────────────────────
# MOI01.VIP — systemd Service Unit
#
# INSTALLATION:
#   1. sudo cp vault/config/moi01.service /etc/systemd/system/moi01.service
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable moi01.service
#   4. sudo systemctl start moi01.service
# ──────────────────────────────────────────────────────────────────────────────

[Unit]
Description=MOI01.VIP Zero-Knowledge Vault Service
Documentation=https://github.com/your-org/moi01-vault
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /var/www/moi01.vip/vault/src/server.js
WorkingDirectory=/var/www/moi01.vip/vault
Restart=always
RestartSec=3s

# Secret Injection from Root-Locked Environment File
EnvironmentFile=/etc/myapp/config.env

# Zero-Knowledge Output
StandardOutput=null
StandardError=null
LimitCORE=0

# Sandboxing & Ephemeral Execution
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
ReadOnlyPaths=/var/www/moi01.vip

[Install]
WantedBy=multi-user.target

